  xuanwuItemId: 6001
  lalaiyeItemId: 8001
  commonFollowUpDialogue:
  - "\u6D77\u5B50\uFF1A\u4E0D\u8FC7\u5C31\u7B97\u5982\u6B64\uFF0C\u4F60\u4E5F\u4E0D\u80FD\u53BB\u89C1\u56FD\u738B\uFF0C\u6211\u4EEC\u90FD\u662F\u6D3B\u7684\u6B7B\u7269\uFF0C\u4E0D\u53EF\u5165\u5927\u6BBF\u7684\u3002"
  - "\u9B54\u5C06\u7384\u6B66\uFF1A\u8981\u662F\u6211\u975E\u8981\u8FDB\u53BB\u600E\u4E48\u529E\uFF1F"
  - "\u6D77\u5B50\uFF1A\u5927\u6982\u4F1A\u53D8\u6210\u771F\u7684\u6B7B\u7269\u5427\uFF1F"
  - "\u9B54\u5C06\u7384\u6B66\uFF1A\u90A3\u2026\u2026\u8FD8\u662F\u4F60\u4EEC\u4E24\u8FDB\u53BB\u5427\u3002"
