--- !u!114 &589826779
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 589826775}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 80e40f77b1621864b91c77836df1a928, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionText: "\u6309E\u4EA4\u4E92"
  isInteractable: 1
  highlightOnHover: 1
  highlightColor: {r: 1, g: 0.92156863, b: 0.015686275, a: 1}
  highlightIntensity: 1.5
  npcId: "\u7CBE\u7075\u8D35\u65CF"
  speakerName: "\u7CBE\u7075\u8D35\u65CF"
  initialDialogue:
  - "\u7CBE\u7075\u8D35\u65CF\uFF1A\u600E\u4E48\u529E\uFF1F\u600E\u4E48\u529E\uFF1F"
  - "\u7CBE\u7075\u8D35\u65CF\uFF1A\u6211\u9001\u7ED9\u5973\u738B\u5927\u4EBA\u7684\u540D\u8D35\u74F7\u5668\u88AB\u6454\u788E\u4E86\u3002"
  - "\u7CBE\u7075\u8D35\u65CF\uFF1A\u4ECA\u5929\u8BE5\u4E0A\u54EA\u627E\u66FF\u4EE3\u7684\u4E1C\u897F\u732E\u4E0A\u53BB\u554A\uFF1F"
  stage5ConditionName: canTalkWithQika
  expectedConditionValue: 1
  conditionTrueDialogue:
  - "\u8389\u59C6\u8389\u5361\uFF1A\u90A3\u4E2A\u60C5\u62A5\u5546\u8BF4\u6211\u4EEC\u8EAB\u4E0A\u6709\u79D8\u5B9D\uFF1F\u54EA\u91CC\u6709\u554A\uFF1F"
  - "\u65E0\u540D\u52C7\u8005\uFF1A\u6BD4\u5982\u4F1A\u8BF4\u8BDD\u4F1A\u9884\u6D4B\u5360\u535C\u7684\u77F3\u677F\u7B97\u5417\uFF1F"
  - "\u9B54\u5C06\u7384\u6B66\uFF1A\u4F60\u4EEC\u2026\u2026\u8981\u5E72\u4EC0\u4E48\uFF1F"
  - "\u8389\u59C6\u8389\u5361\uFF1A\u8D35\u5B89\uFF0C\u534E\u8D35\u7684\u8D35\u65CF\u5927\u4EBA\u3002"
  - "\u8389\u59C6\u8389\u5361\uFF1A\u6211\u662F\u6765\u81EA\u4E1C\u8FB9\u56FD\u5EA6\u7684\u4F7F\u8005\uFF0C\u540D\u53EB\u8389\u59C6\u8389\u5361~"
  - "\u8389\u59C6\u8389\u5361\uFF1A\u542C\u95FB\u60A8\u6DF1\u9677\u82E6\u607C\uFF0C\u6070\u597D\u6211\u4EEC\u4E5F\u6709\u793C\u7269\u60F3\u732E\u7ED9\u5973\u738B\u6BBF\u4E0B"
  - "\u8389\u59C6\u8389\u5361\uFF1A\u4E0D\u77E5\u60A8\u53EF\u5426\u613F\u610F\u5E2E\u6211\u4EEC\u5F15\u8350\u4E00\u756A\uFF0C\u4EE5\u60A8\u7684\u540D\u4E49\u4E3A\u5973\u738B\u732E\u4E0A\u73CD\u5B9D\uFF1F"
  - "\u7CBE\u7075\u8D35\u65CF\uFF1A\u771F\u7684\u2026\u2026\u5417\uFF1F"
  - "\u7CBE\u7075\u8D35\u65CF\uFF1A\u771F\u662F\u5927\u5730\u6BCD\u795E\u8D50\u798F\u2026\u2026\u4F60\u4EEC\u7684\u5B9D\u7269\u662F\u4EC0\u4E48\uFF1F"
  - "\u65E0\u540D\u52C7\u8005\uFF1A\u5927\u4EBA\u8BF7\u770B\uFF0C\u8FD9\u662F\u6211\u7B49\u7956\u4F20\u7684\u9884\u8A00\u77F3\u677F\uFF0C\u53EF\u4EE5\u8BF4\u8BDD\u9884\u6D4B\u3002"
  - "\u9B54\u5C06\u7384\u6B66\uFF1A\u989D\u2026\u2026\u4F60\u597D\uFF0C\u4F60\u8981\u5360\u535C\u4EC0\u4E48\uFF1F"
  - "\u7CBE\u7075\u8D35\u65CF\uFF1A\u4F60\u80FD\u544A\u8BC9\u6211\u74F7\u5668\u662F\u8C01\u6454\u788E\u7684\u5417\uFF1F"
  - "\u9B54\u5C06\u7384\u6B66\uFF1A\u989D\u2026\u2026"
  - "\u9B54\u5C06\u7384\u6B66\uFF1A\u55EF\u2026\u2026"
  - "\u9B54\u5C06\u7384\u6B66\uFF1A\u662F\u4E0D\u662F\u4F60\u81EA\u5DF1\u6454\u788E\u7684\u2026\u2026"
  - "\u7CBE\u7075\u8D35\u65CF\uFF1A\u4F60\u8FD9\u77F3\u5934\u2026\u2026\u771F\u51C6\u554A\uFF01\u8FDE\u8FD9\u4E2A\u90FD\u80FD\u7B97\u51FA\u6765"
  - "\u8389\u59C6\u8389\u5361\uFF1A\uFF08\u5413\u6B7B\u6211\u4E86\uFF09"
  - "\u7CBE\u7075\u8D35\u65CF\uFF1A\u6211\u53EB\u505A\u5951\u5361\uFF0C\u8389\u59C6\u8389\u5361\u9601\u4E0B\uFF0C\u6211\u8FD9\u5C31\u5E26\u4F60\u4EEC\u89D0\u89C1\u5973\u738B\u3002"
  conditionFalseDialogue:
  - "\u8389\u59C6\u8389\u5361\uFF1A\u771F\u5012\u9709\u554A\u2026\u2026\u81EA\u6C42\u591A\u798F\u5427~"
  playAnimationAfterTrueBranch: 1
  trueBranchAnimationName: Stage5-4-2
  canRepeatInteraction: 1
