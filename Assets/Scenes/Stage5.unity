    wrongAnswerFollowUp: []
    onFollowUpDialogueComplete:
      m_PersistentCalls:
        m_Calls: []
  - optionText: "C\uFF0C\u6740\u6B7B\u9B54\u738B\u6CE2\u53E5"
    goodEvilChange: -1
    truthChange: 1
    loveDesireChange: 0
    moneyChange: 0
    followUpDialogue:
    - "\u6211\uFF1A\u4F60\u662F\u9B54\u738B\uFF0C\u6211\u662F\u4EBA\u7C7B\uFF0C\u6211\u4E3A\u4EC0\u4E48\u8981\u5E2E\u4F60\u963B\u6B62\u4EBA\u7C7B\u6D88\u706D\u4F60\u5462\uFF1F\u8001\u8D3C\uFF01\u7EB3\u547D\u6765\uFF01"
    - "\u9B54\u738B\u6CE2\u53E5\uFF1A\u88AB\u53EC\u5524\u8005\u662F\u65E0\u6CD5\u653B\u51FB\u53EC\u5524\u8005\u7684\uFF0C\u4F60\u8FD9\u6837\u6CA1\u7528\u7684\u3002\u4E00\u65E6\u6211\u4EEC\u5B8C\u5168\u88AB\u6D88\u706D\uFF0C\u4E16\u754C\u7684\u5E73\u8861\u5C31\u4F1A\u88AB\u6253\u7834\uFF0C\u6574\u4E2A\u4E16\u754C\u5C06\u9677\u5165\u6700\u5F7B\u5E95\u7684\u6BC1\u706D\u3002"
    - "\u6211\uFF1A\u5982\u4F55\u8BC1\u660E\u4F60\u8BF4\u7684\u662F\u771F\u7684\uFF1F"
    - "\u9B54\u738B\u6CE2\u53E5\uFF1A\u4F60\u4E0A\u8DEF\u4E86\u5C31\u81EA\u7136\u77E5\u9053\u4E86\u3002"
    - "\u6211\uFF1A\u597D\uFF0C\u90A3\u6211\u8BE5\u600E\u4E48\u529E\uFF1F"
    - "\u9B54\u738B\u6CE2\u53E5\uFF1A\u8D70\u4E00\u6B65\u770B\u4E00\u6B65\u5427\u3002\u603B\u4E4B\u73B0\u5728\u7684\u4E00\u5207\u90FD\u662F\u4EBA\u7C7B\u738B\u7684\u75AF\u72C2\u5BFC\u81F4\u7684\uFF0C\u60F3\u529E\u6CD5\u8EB2\u8FC7\u4EBA\u7C7B\u773C\u7EBF\u53BB\u738B\u90FD\u5427\u3002\u6211\u5973\u513F\u8BA4\u8DEF\u3002"
