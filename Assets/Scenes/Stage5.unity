  m_Script: {fileID: 11500000, guid: 82664d8d04e7538468fd73b14c12e0ee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionText: "\u6309E\u4EA4\u4E92"
  isInteractable: 1
  highlightOnHover: 1
  highlightColor: {r: 1, g: 0.92156863, b: 0.015686275, a: 1}
  highlightIntensity: 1.5
  speakerName: "\u9B54\u738B\u6CE2\u53E5"
  dialogueLines: []
  isRepeatable: 1
  removeAfterTalk: 0
  npcId: "\u9B54\u738B"
  hasInitialDialogue: 1
  hasRepeatDialogue: 1
  alwaysShowOptions: 0
  requiresSpecificItem: 0
  requiredItemId: 0
  conditionFailMessage: 
  initialDialogueLines:
  - "\u4F60\uFF1A\u8FD9\u91CC\u662F\u2026\u2026\uFF1F\u4EC0\u4E48\u5730\u65B9\uFF1F"
  - "\u9B54\u738B\uFF1F\uFF1A\u6B22\u8FCE\u4F60\u6765\u5230\u8FD9\u91CC\uFF0C\u4F1F\u5927\u7684\u52C7\u8005\u3002\u6211\u662F\u9B54\u738B\u2014\u2014\u6CE2\u53E5\u3002"
  - "\u4F60\uFF1A\u8BF7\u95EE\u2026\u2026"
  - "\u9B54\u738B\u6CE2\u53E5\uFF1A\u6211\u77E5\u9053\u4F60\u5F88\u56F0\u60D1\uFF0C\u95F2\u8BDD\u5C11\u8BF4\uFF0C\u4EBA\u7C7B\u7684\u5927\u519B\u9A6C\u4E0A\u5C31\u8981\u653B\u4E0B\u6211\u4EEC\u6700\u540E\u4E00\u57CE\u4E00\u6C60\u4E86\uFF0C\u6211\u4EEC\u9000\u65E0\u53EF\u9000\uFF0C\u53EA\u80FD\u53EC\u5524\u52C7\u8005\u60A8\u6765\u4E3A\u6211\u4EEC\u529B\u633D\u72C2\u6F9C\u3002"
  - "\u9B54\u738B\u6CE2\u53E5\uFF1A\u6211\u4EEC\u5269\u4F59\u7684\u5175\u529B\u80FD\u591F\u652F\u6491\u7684\u65F6\u95F4\u4E0D\u4E45\u4E86\uFF0C\u8BF7\u4F60\u5E26\u4E0A\u6211\u7684\u5973\u513F\uFF0C\u79BB\u5F00\u8FD9\u91CC\uFF01"
  - "\u9B54\u738B\u6CE2\u53E5\uFF1A\u53EA\u8981\u53BB\u6253\u8D25\u5DF2\u7ECF\u75AF\u72C2\u7684\u4EBA\u7C7B\u5E1D\u738B\uFF0C\u6211\u4EEC\u5C31\u6709\u6551\u4E86\u3002"
  repeatDialogueLines:
  - "\u90FD\u4EA4\u7ED9\u4F60\u4E86\u3002\u6211\u4EEC\u53EA\u5269\u4E0B\u8FD9\u4E2A\u5973\u513F\u4E86\u3002"
  dialogueOptions:
  - optionText: "A\uFF0C\u63A5\u53D7"
    goodEvilChange: 1
    truthChange: 0
    loveDesireChange: 1
    moneyChange: 0
    followUpDialogue:
    - "\u6211\uFF1A\u597D\uFF0C\u90A3\u6211\u8BE5\u600E\u4E48\u529E\uFF1F"
    - "\u9B54\u738B\u6CE2\u53E5\uFF1A\u8D70\u4E00\u6B65\u770B\u4E00\u6B65\u5427\u3002\u603B\u4E4B\u73B0\u5728\u7684\u4E00\u5207\u90FD\u662F\u4EBA\u7C7B\u738B\u7684\u75AF\u72C2\u5BFC\u81F4\u7684\uFF0C\u60F3\u529E\u6CD5\u8EB2\u8FC7\u4EBA\u7C7B\u773C\u7EBF\u53BB\u738B\u90FD\u5427\u3002\u6211\u5973\u513F\u8BA4\u8DEF\u3002"
    - "\u6211\uFF1A\u597D\u7684\u3002"
    isPurchaseOption: 0
    isService: 0
    itemId: 0
    price: 0
    shouldPlayAnimation: 0
    animationName: 
    isMiningOption: 0
    isQuestionOption: 0
    questionId: 0
    rewardItemId: 0
    correctAnswerFollowUp: []
    wrongAnswerFollowUp: []
    onFollowUpDialogueComplete:
      m_PersistentCalls:
        m_Calls: []
  - optionText: "B\uFF0C\u4E0D\u63A5\u53D7"
    goodEvilChange: 0
    truthChange: 1
    loveDesireChange: -1
    moneyChange: 0
    followUpDialogue:
    - "\u6211\uFF1A\u642D\u560E\u6269\u591A\u74E6\u9C81\uFF01"
    - "\u9B54\u738B\u6CE2\u53E5\uFF1A\u5509\uFF0C\u4F46\u662F\u53EC\u5524\u6CD5\u9635\u51B3\u5B9A\u4E86\uFF0C\u5982\u679C\u4F60\u4E0D\u5B8C\u6210\u53EC\u5524\u6761\u4EF6\u4F60\u5C31\u6C38\u8FDC\u56DE\u4E0D\u53BB\u4E86\u3002"
    - "\u6211\uFF1A\u597D\u5427\uFF0C\u6211\u8FD8\u6709\u6211\u5FC5\u987B\u8981\u5B8C\u6210\u7684\u4E8B\uFF0C\u4E0D\u80FD\u7559\u5728\u8FD9\uFF0C\u6211\u8BE5\u600E\u4E48\u529E\uFF1F"
    - "\u9B54\u738B\u6CE2\u53E5\uFF1A\u8D70\u4E00\u6B65\u770B\u4E00\u6B65\u5427\u3002\u603B\u4E4B\u73B0\u5728\u7684\u4E00\u5207\u90FD\u662F\u4EBA\u7C7B\u738B\u7684\u75AF\u72C2\u5BFC\u81F4\u7684\uFF0C\u60F3\u529E\u6CD5\u8EB2\u8FC7\u4EBA\u7C7B\u773C\u7EBF\u53BB\u738B\u90FD\u5427\u3002\u6211\u5973\u513F\u8BA4\u8DEF\u3002"
    - "\u6211\uFF1A\u597D\u7684\u3002"
    isPurchaseOption: 0
    isService: 0
    itemId: 0
    price: 0
    shouldPlayAnimation: 0
    animationName: 
