  initialDialogueLines:
  - "\u8DEF\u65C1\u7684\u77F3\u5934\uFF1A\u4F60\u4EEC\u597D\uFF0C\u6211\u60F3\u4F60\u4EEC\u4F1A\u9700\u8981\u6211\u7684\u5E2E\u52A9\u7684\u3002"
  - "\u65E0\u540D\u52C7\u8005\uFF1A\u4F60\u662F\u8C01\uFF1F"
  - "\u4F1A\u8BF4\u8BDD\u7684\u77F3\u5934\uFF1A\u6211\u662F\u3010\u9B54\u5C06\xB7\u7384\u6B66\u3011\u3002\u4F60\u8EAB\u8FB9\u662F\u516C\u4E3B\u5927\u4EBA\u5427\uFF1F"
  - "\u8389\u59C6\u8389\u5361\uFF1A\u4F60\u5C45\u7136\u8FD8\u8BB0\u5F97\u6211\u554A\uFF0C\u4E0D\u8FC7\u4F60\u73B0\u5728\u600E\u4E48\u53D8\u6210\u8FD9\u6837\u5B50\u4E86\uFF1F"
